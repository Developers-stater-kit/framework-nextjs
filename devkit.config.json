{
    "config": {
        "type": "framework",
        "key": "nextjs",
        "name": "Nextjs",
        "version": "16.1.4",
        "router": "app",
        "directory": "app",
        "typescript": true,
        "tailwindcss": true
    },
    "repo": {
        "name": "framework-nextjs",
        "branch": "base"
    },
    "structure": {
        "layout": "app/layout.tsx",
        "page": "app/page.tsx",
        "apiRoot": "app/api",
        "middleware": "middleware.ts",
        "envExample": ".env.example"
    },
    "mergerOrder": [
        "database",
        "authentication",
        "payments"
    ],
    "paths":{
        "db-orm":{
            "config": ".",
            "client": "db/drizzle.ts",
            "schema": "db/schema.ts"
        }
    }
}
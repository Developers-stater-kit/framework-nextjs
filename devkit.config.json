{
    "config": {
        "type": "framework",
        "key": "nextjs",
        "router": "app",
        "typescript": true,
        "tailwindcss": true
    },
    "repo": {
        "name": "framework-nextjs",
        "branch": "base"
    },
    "structure": {
        "src": {
            "layout": "src/app/layout.tsx",
            "page": "src/app/page.tsx",
            "apiRoot": "src/app/api",
            "middleware": "src/middleware.ts",
            "envExample": ".env.example"
        },
        "app": {
            "layout": "app/layout.tsx",
            "page": "app/page.tsx",
            "apiRoot": "app/api",
            "middleware": "middleware.ts",
            "envExample": ".env.example"
        }
    },
    "mergerOrder": [
        "db-orm",
        "authentication",
        "payments"
    ],
    "paths": {
        "db-orm": {
            "src": {
                "config": ".",
                "client": "src/db/<client>",
                "schema": "src/db/<schema>"
            },
            "app": {
                "config": ".",
                "client": "db/<client>",
                "schema": "db/<schema>"
            }
        }
    }
}
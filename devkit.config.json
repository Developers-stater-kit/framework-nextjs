{
    "type": "framework",
    "package": "nextjs",
    "config": {
        "router": "app",
        "typescript": true,
        "tailwindcss": true
    },
    "repo": {
        "name": "framework-nextjs",
        "branch": "base"
    },
    "metadata": {
        "envVars": [],
        "dependencies": [],
        "devDependencies": []
    },
    "structure": {
        "app": "src/app",
        "db": "src/db",
        "utils": "src/utils",
        "lib": "src/lib",
        "components": "src/components",
        "apiRoot": "src/app/api",
        "middleware": ".",
        "envExample": "./.env.example"
    },
    "paths": {
        "db-orm": {
            "config": ".",
            "client": "<db>/",
            "schema": "<db>/"
        },
        "authentication": {
            "server": "<lib>/",
            "client": "<lib>/",
            "api": "<apiRoot>/auth/[...all]/",
            "middleware": "<middleware>",
            "ui": "<components>/auth/"
        }
    },
    "mergerOrder": [
        "db-orm",
        "authentication",
        "payments"
    ]
}
{
    "config": {
        "type": "framework",
        "key": "nextjs",
        "router": "app",
        "typescript": true,
        "tailwindcss": true
    },
    "repo": {
        "name": "framework-nextjs",
        "branch": "base"
    },
    "metadata": {
        "envVars": [],
        "dependencies": [],
        "devDependencies": []
    },
    "structure": {
        "layout": "src/app/layout.tsx",
        "page": "src/app/page.tsx",
        "apiRoot": "src/app/api",
        "middleware": "src/middleware.ts",
        "envExample": ".env.example"
    },
    "mergerOrder": [
        "db-orm",
        "authentication",
        "payments"
    ],
    "paths": {
        "db-orm": {
            "config": ".",
            "client": "src/db/<client>",
            "schema": "src/db/<schema>"
        }
    }
}